<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{% block title %}{% endblock %}</title>
<style>
  :root {
    --ink: #1f1f1f;
    --muted: #686868;
    --line: #e2e2de;
    --panel: #f5f5f2;
    --accent: #0072b2;
    --track: #ececea;
  }
  * { box-sizing: border-box; }
  html { background: #ffffff; }
  body {
    margin: 0;
    background: #ffffff;
    color: var(--ink);
    font: 13px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  .page { max-width: 900px; margin: 0 auto; padding: 24px 16px 28px; }
  header.top {
    display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: space-between;
    align-items: flex-end; border-bottom: 3px solid var(--ink); padding-bottom: 10px;
  }
  .kicker { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  h1 { font-size: 28px; line-height: 1.15; margin: 4px 0 2px; letter-spacing: -.01em; }
  h2 {
    font-size: 11.5px; letter-spacing: .07em; text-transform: uppercase; color: var(--muted);
    margin: 18px 0 8px; padding-bottom: 4px; border-bottom: 1px solid var(--line);
  }
  .role {
    font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px;
    background: var(--panel); border: 1px solid var(--line); white-space: nowrap;
  }
  .role.pick { background: var(--ink); color: #ffffff; border-color: var(--ink); }
  dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: 2px 14px; margin: 12px 0 0; }
  dl.facts dt { color: var(--muted); }
  dl.facts dd { margin: 0; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; margin-top: 14px; }
  .tile { background: var(--panel); border-radius: 8px; padding: 10px 12px; }
  .tile .label { font-size: 11px; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .tile .value { font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; margin: 2px 0; }
  .tile .note { font-size: 11.5px; color: var(--muted); }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; }
  .cols > section { min-width: 0; }
  img.figure { display: block; width: 100%; height: auto; }
  .caption { font-size: 11.5px; color: var(--muted); margin-top: 4px; }
  ul.points { list-style: none; padding: 0; margin: 0 0 6px; }
  ul.points li { display: flex; gap: 8px; align-items: baseline; padding: 3px 0; border-bottom: 1px solid var(--line); }
  ul.points li .what { flex: 1; }
  ul.points li .value { color: var(--muted); font-size: 12px; }
  .chip {
    min-width: 34px; text-align: center; font-weight: 700; font-size: 12px; border-radius: 4px;
    padding: 1px 6px; font-variant-numeric: tabular-nums; background: var(--panel); border: 1px solid var(--line);
  }
  .empty { color: var(--muted); font-style: italic; margin: 2px 0 8px; }
  h3 { font-size: 13px; margin: 10px 0 4px; }
  table { border-collapse: collapse; width: 100%; font-size: 12px; }
  th, td { padding: 4px 6px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
  th { font-size: 11px; font-weight: 600; color: var(--muted); }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .meter { position: relative; height: 10px; background: var(--track); border-radius: 2px; min-width: 90px; }
  .meter .fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 2px; }
  .meter .mark { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--ink); }
  .swatch { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 6px; vertical-align: baseline; }
  .legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 11.5px; color: var(--muted); margin-top: 4px; }
  .notes { background: var(--panel); border-left: 3px solid var(--ink); padding: 8px 12px; margin-top: 8px; }
  .notes p { margin: 4px 0; }
  footer {
    margin-top: 22px; padding-top: 8px; border-top: 1px solid var(--line);
    font-size: 11px; color: var(--muted);
  }
  footer p { margin: 3px 0; }
  a { color: var(--accent); }
  @media (max-width: 640px) {
    .cols { grid-template-columns: 1fr; }
    h1 { font-size: 24px; }
  }
  @page { size: A4; margin: 10mm; }
  @media print {
    .page { max-width: none; padding: 0; }
    section, .tiles, table { break-inside: avoid; }
  }
</style>
</head>
<body>
<main class="page">
{% block content %}{% endblock %}
</main>
</body>
</html>
